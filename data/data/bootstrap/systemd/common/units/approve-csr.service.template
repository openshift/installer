[Unit]
Description=Approve CSRs during bootstrap phase
Wants=bootkube.service
After=bootkube.service

[Service]
Environment="APPROVE_CSR_MACHINE_NETWORKS={{.MachineNetworks}}"
ExecStart=/usr/local/bin/approve-csr.sh /opt/openshift/auth/kubeconfig-loopback {{.ApproveCSRMaxNodes}}

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
